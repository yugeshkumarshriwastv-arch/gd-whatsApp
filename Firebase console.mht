.mat-mdc-button-base .mat-icon { flex-shrink: 1 !important; min-height: auto !important; }

.mat-mdc-chip-touch-target.mat-mdc-chip-touch-target { display: none; }

.mat-mdc-chip-listbox .mdc-evolution-chip.mdc-evolution-chip, .mat-mdc-chip-set .mdc-evolution-chip.mdc-evolution-chip, .mdc-evolution-chip-set .mdc-evolution-chip.mdc-evolution-chip { margin: 4px 0px 4px 8px; }

